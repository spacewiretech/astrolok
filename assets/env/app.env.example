# Copy to app.env and fill in. app.env is gitignored.
#
# With both Supabase values set the app talks to Edge Functions, which hold the Fast2SMS and
# Cashfree credentials server-side. Leave them blank and the app falls back: to Fast2SMS
# directly if the two FAST2SMS values are set, otherwise to the in-memory fake tier where any
# 6-digit code signs in and the paywall charges nothing.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Legacy direct-to-Fast2SMS path only. Setting these ships the API key inside the app, so
# prefer Supabase. FAST2SMS_OTP_ID is the OTP Template ID from the Fast2SMS dashboard.
#
# Both fall through to the `fast2sms_api_key` / `fast2sms_otp_id` rows in the mirror below, so
# a whole-table paste is enough and these two can stay blank.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# ---------------------------------------------------------------- app_config mirror
#
# A snapshot of the `app_config` table, used when Supabase is unreachable or has never been
# reached. Precedence is: these rows sit ABOVE the compiled `defaultAppConfig` and BELOW the
# disk cache and the server, because the cache holds the last known server state and that is
# fresher truth than a snapshot taken when this build was cut.
#
# The dashboard stays authoritative. After changing a row in Supabase, update the matching line
# here before the next release, or an offline install serves the old value until it can fetch.
#
# Keys are the table's own, verbatim, so the block can be regenerated by pasting a
# `select key, value from app_config order by key` straight in. Anything here that is not one
# of the four UPPERCASE names above is treated as an `app_config` row, so a row added to the
# table later needs a line here and no Dart change at all.
#
# NOTE: every file under assets/env/ is bundled into the released app — see ../README.md.
# Whatever is written here is readable by anyone holding the .apk or .ipa. The rows Supabase
# marks `is_public = false` are read server-side by Edge Functions with `service_role` and are
# never fetched by the client, so they are only worth filling in if you have decided you want
# them in the bundle.
#
# Parser rules (flutter_dotenv):
#   - An unquoted `#` anywhere in a value truncates it. Single-quote any value containing one.
#   - `$` interpolates, and substitutes an empty string when the name is unknown. Single quotes
#     disable that entirely.
#   - An empty value must be written bare (`rating_label=`), never as `rating_label=""` — the
#     quote-stripping regex needs a character between the quotes, so `""` survives as two
#     literal quote characters.
#   - Blank values are dropped when the map is built: a bare `key=` means "use the compiled
#     default", never "force this key empty".
#   - Values are trimmed; a duplicate key keeps the first occurrence.

allow_dev_otp=
api_base_url=
cashfree_api_version=
cashfree_app_id=
cashfree_env=
cashfree_plan_id=
cashfree_plan_name=
cashfree_recurring_amount=
cashfree_secret_key=
cashfree_trial_amount=

# Kept at 1 in app.env even though the dashboard says 2. The row is `is_public = false`, so RLS
# has always hidden it and the paywall has been quoting the compiled default of 1 day; raising
# it changes the consent copy and the marketing site together, which is a pricing decision.
cashfree_trial_days=

chat_facts_max=
chat_history_turns=
# Comma-separated, e.g. `Hinglish,English,Hindi`. The Profile picker reads it, and adding a
# language to the dashboard row reaches installed apps without a release. Leaving it blank in
# `app_config` hides the picker; leaving it blank *here* just means the compiled default stands
# in until the first fetch.
chat_languages=
chat_language_default=
chat_messages_per_day=
# Private, and not read by the client at all — listed for completeness. `v2` is the current
# prompt, `v1` the one that shipped before answers were reworked. Flipping the dashboard row to
# `v1` reverts Astro within a minute, no redeploy.
chat_prompt_version=
currency_code=
entitlement_grace_hours=
env=
face_readings_per_day=
facebook_app_id=
facebook_events_enabled=
fast2sms_api_key=
fast2sms_dlt_pe_id=
fast2sms_dlt_te_id=
fast2sms_otp_id=
fast2sms_sender_id=
GEMINI_AI_KEY=
gemini_api_key=
gemini_model=
gemini_model_fallback=
help_url=
min_supported_version=

# Blank here means no analytics: absence of this key is what leaves the app on NoopAnalytics,
# which is the right behaviour for a checkout not pointed at a Mixpanel project.
mixpanel_token=

otp_expiry_minutes=
otp_length=
otp_resend_cooldown_seconds=
palm_readings_per_day=
paywall_video_url=
plan_price_amount=
plan_price_label=
privacy_url=
rating_label=
reconcile_secret=
reconcile_stale_hours=
review_mobile=
review_otp=
subscriber_label=
support_url=
terms_url=
trial_price_amount=
trial_price_label=
