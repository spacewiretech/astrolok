# Copy to app.env and fill in. app.env is gitignored.
#
# With both Supabase values set the app talks to Edge Functions, which hold the Fast2SMS and
# Cashfree credentials server-side. Leave them blank and the app falls back: to Fast2SMS
# directly if the two FAST2SMS values are set, otherwise to the in-memory fake tier where any
# 6-digit code signs in and the paywall charges nothing.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Legacy direct-to-Fast2SMS path only. Setting these ships the API key inside the app, so
# prefer Supabase. FAST2SMS_OTP_ID is the OTP Template ID from the Fast2SMS dashboard.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
