<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The app is advertised through Facebook Ads, which attributes installs by advertising ID.
         Declared by hand rather than pulled in with an SDK: Play reads this permission off the
         uploaded bundle to decide whether to ask the advertising-ID questions in Data safety, and
         without it the store treats the app as not touching the ad ID at all. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <!-- Palm reading photographs the user's hand. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- camera_android_camerax declares RECORD_AUDIO for video capture. This app never records
         audio, and a microphone permission on a palm reader reads as spyware on the store
         listing, so it is merged out rather than inherited. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>

    <!-- Not required: a device with no camera can still upload a photo from its gallery, and
         marking this required would hide the app from those devices on the Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="Astrolok"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- Off deliberately. The splash resolves the session and decides where the user
                 belongs; letting the engine route a deeplink straight to a screen would skip
                 that gate. The payment redirect below is handled by the Cashfree SDK. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- The Cashfree `return_url` (astrolok://payment?sub=...). The SDK normally hands
                 control back through its own callback and this is only used by the web
                 fallback, but without the filter that redirect dead-ends on "no app can handle
                 this link". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="astrolok" android:host="payment"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- REQUIRED. Without this the Cashfree SDK never fires the subscription callback, so
             every mandate appears to hang even when the money moved. -->
        <meta-data
            android:name="cashfree_subscription_flow_enable"
            android:value="true" />
    </application>

    <queries>
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility and
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- REQUIRED on Android 11+ for flutter_tts to find a speech engine. Package
             visibility is filtered by default, so without this the reading appears to play
             and no sound comes out — with no error to explain why. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>

        <!-- REQUIRED for UPI app discovery on Android 11+. Package visibility is filtered by
             default, so without this `getUPIApps()` returns an empty list on every modern
             device and the paywall silently falls back to the Cashfree checkout screen. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
    </queries>
</manifest>
