<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Astrolok</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>astrolok</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Both strings are shown verbatim in the system permission dialog. iOS terminates the
	     app on first access if the matching key is absent, so these are load-bearing, not
	     documentation. -->
	<key>NSCameraUsageDescription</key>
	<string>Astrolok uses your camera to photograph your palm or your face, so it can read them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Astrolok needs your photo library so you can choose a photo of your palm or your face.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.spacewire.astrolok.payment</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>astrolok</string>
			</array>
		</dict>
		<!-- Facebook's own scheme, fb<APP_ID>. A separate URL type rather than another entry in the
		     payment array above, so the Cashfree return_url and the Facebook callback cannot be
		     mistaken for one another. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.spacewire.astrolok.facebook</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb$(FACEBOOK_APP_ID)</string>
			</array>
		</dict>
	</array>
	<!-- Facebook Ads conversion reporting.

	     Substituted at build time from ios/Flutter/Facebook.xcconfig, which is gitignored and
	     documented by Facebook.xcconfig.example beside it. Debug.xcconfig and Release.xcconfig
	     define blank defaults before optionally including it, so a checkout without that file
	     still builds — the SDK simply comes up with no app id and reports nothing.

	     Neither value is a secret: both ship inside every installed app by design. The Facebook
	     **app secret** is not here, and is not used by this app anywhere. -->
	<key>FacebookAppID</key>
	<string>$(FACEBOOK_APP_ID)</string>
	<key>FacebookClientToken</key>
	<string>$(FACEBOOK_CLIENT_TOKEN)</string>
	<key>FacebookDisplayName</key>
	<string>Astrolok</string>
	<!-- Why the app asks to track, shown verbatim inside Apple's own dialog. Names the benefit
	     rather than the mechanism: "allow tracking" means nothing to the person reading it, and a
	     vague reason is the most reliable way to be denied. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Allow tracking so we can tell which ads bring people to Astrolok, and stop paying for the ones that don't. It does not change your readings.</string>
	<!-- Facebook's SKAdNetwork identifiers. Apple's install-attribution channel, and the only one
	     left when a user declines the prompt above — which most do. Without these the campaign is
	     unattributable for that majority. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>n38lu8286q.skadnetwork</string>
		</dict>
	</array>
	<!-- Off deliberately: the splash resolves the session and decides where the user belongs,
	     so the engine must not route a deeplink straight past that gate. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<!-- The exact set the Cashfree SDK probes when listing installed UPI apps. iOS answers
	     canOpenURL with false for any scheme not declared here, so a missing entry silently
	     hides an app the user actually has installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>upi</string>
		<string>phonepe</string>
		<string>tez</string>
		<string>paytmmp</string>
		<string>bhim</string>
		<string>amazonpay</string>
		<string>mobikwik</string>
		<string>credpay</string>
		<!-- Appended for the Facebook SDK, which probes these to decide whether it can hand off to
		     an installed Facebook or Messenger app. The eight UPI schemes above are load-bearing for
		     Cashfree's installed-app detection — this list is added to, never replaced. -->
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
	</array>
</dict>
</plist>
